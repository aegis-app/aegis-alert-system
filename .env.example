# A.A.S (Aegis Alert System) — example environment configuration.
# Copy to .env and fill in your own values. Never commit .env.
# All values below are safe local-development defaults.

# --- Listeners -------------------------------------------------------------
# Bind host. Keep 127.0.0.1 unless the hub must serve other machines on a
# private network you control. Never expose the owner listener to the
# public internet.
A2S_HOST=127.0.0.1
# Owner listener port.
A2S_PORT=8730
# Public listener port (binds 127.0.0.1 only). Leave unset to disable the
# public listener entirely.
# A2S_PUBLIC_PORT=8731

# --- Authentication ----------------------------------------------------------
# Owner (shared) token. If unset, the owner listener runs WITHOUT
# authentication (development only) and a warning is logged at startup.
# A2S_TOKEN=
# Per-client tokens for the public listener, format: name1:token1,name2:token2
# The names "owner" and "anonymous" are reserved and rejected.
# A2S_CLIENT_TOKENS=
# Client names allowed to receive EEW on the public listener (comma-separated).
# EEW is delivered to a public client only when its name is listed here AND
# the EEW supply is DMDSS (A2S_DMDSS_API_KEY set).
# A2S_PUBLIC_EEW_CLIENTS=

# --- CORS ----------------------------------------------------------------------
# Origins allowed to read the API from a browser (comma-separated).
# Invalid entries are ignored; if none are valid, the default below is used.
A2S_CORS_ORIGINS=https://bosai.vercel.app

# --- Data files ------------------------------------------------------------------
A2S_DATA_FILE=data/events.json
A2S_ACCESS_LOG_FILE=data/access.log

# --- Ingest: P2P earthquake information -------------------------------------------
A2S_P2P_EEW_INTERVAL_MS=15000
A2S_P2P_QUAKE_INTERVAL_MS=30000
A2S_P2P_TSUNAMI_INTERVAL_MS=30000

# --- Ingest: Wolfx ------------------------------------------------------------------
A2S_WOLFX_HTTP_INTERVAL_MS=20000

# --- Ingest: DMDSS (dmdata.jp) -------------------------------------------------------
# API key. If unset, DMDSS ingest is completely disabled.
# A2S_DMDSS_API_KEY=
# Classifications to subscribe to (comma-separated). Defaults to
# eew.forecast + telegram.earthquake. Match this to your contract
# (forecast-only contract: eew.forecast).
# A2S_DMDSS_CLASSIFICATIONS=

# --- Ingest: JMA ---------------------------------------------------------------------
A2S_JMA_WARNING_INTERVAL_MS=60000
A2S_JMA_TYPHOON_INTERVAL_MS=300000
A2S_JMA_XML_INTERVAL_MS=60000

# --- Ingest: Rivers / dams (MLIT "Kawa no Bousai") -------------------------------------
# 0 disables river ingest entirely. NOTE: in the current production
# deployment river ingest is DISABLED (set to 0) pending a permanent fix
# for patrol load; keep it disabled unless you know the fix has landed.
A2S_RIVER_INTERVAL_MS=600000
A2S_RIVER_CONCURRENCY=8
A2S_RIVER_SYSTEM_DELAY_MS=0

# --- Ingest: Heat (MOE WBGT) ------------------------------------------------------------
A2S_HEAT_INTERVAL_MS=1800000
